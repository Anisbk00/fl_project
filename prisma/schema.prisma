// ============================================================================
// Music Project Store — Prisma schema (Step 1: secure catalog data layer)
// ----------------------------------------------------------------------------
// PRODUCTION MAPPING (read this!):
// In production this model is backed by Supabase Postgres with:
//   - native Postgres enums for the status fields (Prisma SQLite cannot express
//     enums, so they are stored as String here and enforced by the application
//     Zod schemas in src/features/catalog/schema.ts);
//   - CHECK constraints enforcing the publication rule ("a product may not be
//     published unless rights_status IN (original, licensed) AND published_at
//     IS NOT NULL AND price >= 0 AND currency IS NOT NULL ...");
//   - Row-Level Security policies implementing the access matrix in
//     docs/SECURITY.md (anon reads only published+rights-cleared rows; admin
//     allow-list mutation only);
//   - a SECURITY DEFINER is_admin() function keyed on auth.users.id against
//     the AdminUser allow-list (mapped here to src/lib/auth/is-admin.ts).
// The SQL equivalents live in supabase/migrations/ (committed for the future
// hosted project; NOT runnable in this SQLite sandbox).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Admin allow-list (private). Never exposed publicly. Keyed by the Supabase
// auth.users.id (TEXT UUID). In production this table is readable only by the
// owner / service role; the is_admin() SECURITY DEFINER function consults it.
// ---------------------------------------------------------------------------
model AdminUser {
  // Supabase auth.users.id (UUID string). Provisioned manually; public
  // self-sign-up is disabled.
  userId    String   @id @map("user_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Normalized taxonomy.
// ---------------------------------------------------------------------------
model Genre {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  createdAt DateTime       @default(now()) @map("created_at")
  products  ProductGenre[]
}

model Plugin {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  vendor    String?
  createdAt DateTime        @default(now()) @map("created_at")
  products  ProductPlugin[]
}

// ---------------------------------------------------------------------------
// Product — the core catalog entity.
//
// Status semantics:
//   lifecycle:  draft | published | archived
//                - only `published` rows are ever returned to public visitors
//   rights:     unreviewed | original | licensed | rejected
//                - a product CANNOT be published unless rights is
//                  `original` or `licensed` (enforced in code in
//                  src/features/catalog/publish-constraint.ts; in production
//                  also by a DB CHECK constraint)
//
// Money is stored as integer minor currency units (e.g. cents) per the plan.
// priceCurrency is an uppercase ISO 4217-style code (e.g. "USD").
// ---------------------------------------------------------------------------
model Product {
  id String @id @default(cuid())

  // --- Identity / copy ---
  slug String @unique
  title String
  shortDescription String @map("short_description")
  // Long description stored as safe Markdown / plain text. Rendered through a
  // Markdown renderer that strips raw HTML — never dangerouslySetInnerHTML.
  longDescription String? @map("long_description")

  // --- Classification ---
  productType String @map("product_type") // project_file | remake | stems | sample_pack
  lifecycle   String @default("draft") // draft | published | archived
  rightsStatus String @default("unreviewed") @map("rights_status") // unreviewed | original | licensed | rejected

  // --- Pricing (integer minor units) ---
  price          Int     // >= 0; 0 means free
  priceCurrency  String  @default("USD") @map("price_currency")
  compareAtPrice Int?    @map("compare_at_price") // >= price when set

  // --- Technical / musical metadata ---
  dawName    String?  @map("daw_name") // e.g. "FL Studio", "Ableton Live"
  dawVersion String?  @map("daw_version")
  bpm        Int? // 1..400 sensible range, validated in Zod
  musicalKey String? @map("musical_key") // e.g. "A minor"
  durationSeconds Int? @map("duration_seconds")
  totalSizeBytes  Int? @map("total_size_bytes")
  includedFormats  String? @map("included_formats") // human-readable label list
  featured        Boolean @default(false)

  // --- SEO ---
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  // --- Lifecycle timestamps ---
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")

  // --- Audit: creating / updating admin (Supabase auth.users.id) ---
  createdById String? @map("created_by_id")
  updatedById String? @map("updated_by_id")

  // --- Relations ---
  genres       ProductGenre[]
  plugins      ProductPlugin[]
  media        ProductMedia[]
  deliverables ProductDeliverable[]

  @@index([lifecycle, rightsStatus, publishedAt(sort: Desc)])
  @@index([slug])
  @@index([featured, lifecycle])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Product <-> Genre join.
// ---------------------------------------------------------------------------
model ProductGenre {
  productId String  @map("product_id")
  genreId   String  @map("genre_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([productId, genreId])
  @@index([genreId])
  @@map("product_genres")
}

// ---------------------------------------------------------------------------
// Product <-> Plugin requirement join, with min version + required flag.
// ---------------------------------------------------------------------------
model ProductPlugin {
  productId     String  @map("product_id")
  pluginId      String  @map("plugin_id")
  minVersion    String? @map("min_version")
  required      Boolean @default(true)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  plugin        Plugin  @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([productId, pluginId])
  @@index([pluginId])
  @@map("product_plugins")
}

// ---------------------------------------------------------------------------
// PUBLIC preview media (cover images, compressed audio/video previews).
// Lives in the `product-public` Supabase Storage bucket (intentionally public
// for CDN delivery). storageObjectPath is versioned/immutable.
// A validated external video URL is also permitted (e.g. a self-hosted
// preview) but never an arbitrary third-party embed.
// ---------------------------------------------------------------------------
model ProductMedia {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind       String // cover_image | audio_preview | video_preview
  bucket     String @default("product-public")
  // Versioned, immutable object path. NEVER overwrite the same CDN path.
  storageObjectPath String? @map("storage_object_path")
  // Optional validated external URL (only for video previews).
  externalUrl String? @map("external_url")
  mimeType   String? @map("mime_type")
  bytes      Int?
  altText    String? @map("alt_text")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([productId, kind])
  @@map("product_media")
}

// ---------------------------------------------------------------------------
// PRIVATE paid deliverables (archives, project files, stems).
// Lives in the `product-private` Supabase Storage bucket. NEVER exposed by a
// permanent public URL; a verified fulfillment server issues short-lived
// signed URLs after checking payment + download grant (Step 6).
// This table is NEVER returned by any public catalog read path.
// ---------------------------------------------------------------------------
model ProductDeliverable {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  bucket            String  @default("product-private")
  // Immutable object path in the private bucket. Not exposed publicly.
  storageObjectPath String  @map("storage_object_path")
  // Customer-facing filename shown on download.
  customerFilename  String  @map("customer_filename")
  mimeType          String  @map("mime_type")
  bytes             Int
  version           Int     @default(1)
  // SHA-256 checksum of the stored object, for integrity verification.
  sha256            String? @map("sha_256")
  active            Boolean @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([productId, active])
  @@map("product_deliverables")
}
