# ---------------------------------------------------------------------------
# Music Project Store — environment variables (TEMPLATE ONLY).
# Copy to `.env.local` and fill with real values. Never commit real secrets.
# `.env*` files are git-ignored except this example.
#
# There is NO local database and NO Prisma — Supabase is the only data
# platform. The current Supabase key model is used: sb_publishable_... and
# sb_secret_... Do NOT use the legacy anon/service_role variables here.
# ---------------------------------------------------------------------------

# --- Public site (safe to expose to the browser) ---
# Canonical, absolute site URL (no trailing slash). Used for canonical URLs,
# Open Graph, sitemap, and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Audio Project Store

# --- Public Supabase config (safe to expose; RLS is the real boundary) ---
# These use the publishable key. RLS must be enabled on every exposed table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only Supabase config (NEVER expose to the browser) ---
# The secret key is imported only from server-only modules. It must never
# appear in a client bundle, log, URL, or error message.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Server-only Stripe + cart secrets (Step 5; NEVER NEXT_PUBLIC_) ---
# Stripe secret key. Use a TEST key (sk_test_…) for sandbox. Live keys are
# refused-closed until LIVE_CHECKOUT_ENABLED + all release gates are set.
STRIPE_SECRET_KEY=
# Endpoint-specific webhook signing secret (Stripe CLI / Dashboard). Keep test
# and live webhook secrets separate.
STRIPE_WEBHOOK_SECRET=
# Server-only HMAC pepper for cart-token digests. Generate a >=32-byte random
# value. Never logged, never in a URL/metadata/client bundle.
CART_TOKEN_PEPPER=
# Comma-separated canonical checkout origins (no trailing slash), e.g.
# http://localhost:3000,https://store.example.com - success/cancel URLs are
# derived only from this allow-list, never from request Origin/Referer.
CHECKOUT_ORIGIN_ALLOWLIST=http://localhost:3000
# Fail-closed live-payment gate. Leave 0/false for sandbox. Setting 1 does NOT
# alone enable live charges - legal/tax/fulfillment/monitoring gates are also
# required (see docs/TAX_AND_CHECKOUT_LEGAL.md).
RESEND_WEBHOOK_SECRET=
# Bearer token for the fulfillment-drain cron route.
CRON_SECRET=
LIVE_CHECKOUT_ENABLED=0
