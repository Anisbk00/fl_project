# -----------------------------------------------------------------------------
# FL store — environment variables (TEMPLATE: names only, never real values).
# Copy to .env.local for local dev. In Vercel, set these per environment
# (Development / Preview / Production) — never point Production at test keys
# or Preview at the production database.
# -----------------------------------------------------------------------------

# --- Public (shipped to the browser; must contain NO secrets) ---------------
# Canonical absolute site URL, no trailing slash. Used for canonical/OG URLs,
# the sitemap, Stripe success/cancel URLs, email links and the CSRF origin check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=
# Supabase project URL + PUBLISHABLE key (sb_publishable_…). RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Monitored support mailbox: shown on /contact and in every delivery email.
# Required for delivery emails to send.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Supabase server-only ----------------------------------------------------
# Same project URL + SECRET key (sb_secret_…). Server code only; never logged.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Stripe (server-only) ----------------------------------------------------
# sk_test_… in Development/Preview, sk_live_… in Production only.
STRIPE_SECRET_KEY=
# Signing secret of THIS environment's webhook endpoint (/api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=
# Live keys are refused unless this is 1 (fail-closed launch switch).
LIVE_CHECKOUT_ENABLED=0
# Allowed checkout origins, comma-separated, no trailing slash. Must include
# NEXT_PUBLIC_SITE_URL or checkout refuses to start.
CHECKOUT_ORIGIN_ALLOWLIST=http://localhost:3000
# HMAC pepper for guest-cart cookie digests. Generate: openssl rand -hex 32
CART_TOKEN_PEPPER=

# --- Email delivery via Resend (server-only) -------------------------------
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "FL Store <orders@yourdomain.com>".
RESEND_FROM_EMAIL=
# Signing secret of the Resend webhook endpoint (/api/resend/webhook).
RESEND_WEBHOOK_SECRET=

# --- Download access tokens (server-only) -----------------------------------
# 32-byte root key, hex. Generate: openssl rand -hex 32
# Rotation: move the current key to FULFILLMENT_PREV_KEY_HEX, set a new one
# here, and increment FULFILLMENT_KEY_VERSION. Never delete a previous key
# while issued links (72 h) may still depend on it.
FULFILLMENT_ROOT_KEY_HEX=
FULFILLMENT_PREV_KEY_HEX=
FULFILLMENT_KEY_VERSION=1

# --- Cron (server-only) ------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/fulfillment-drain.
# Generate: openssl rand -hex 32
CRON_SECRET=
